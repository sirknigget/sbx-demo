{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "sandbox": {
    "enabled": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/sbx-demo/session-start.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
